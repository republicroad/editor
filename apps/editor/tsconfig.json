{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["bun-types"],
    // zen-udf 以 TS 源发布（ADR: ESM source publish），其 src 进入本编译程序；
    // 0.11.1 的 tool()/pack() 参数类型存在 ctx 必选/可选漂移（UdfTool required vs
    // 注册参数 optional），strictFunctionTypes 逆变检查必报——属依赖源码缺陷
    // （docs/libsuggest/S012，内核修复发版后移除本豁免恢复全严格）。
    "strictFunctionTypes": false
  },
  "include": ["src/**/*.ts"]
}
