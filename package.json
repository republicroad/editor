    "preview": "vite preview --host",
    "test:components": "bun test component-tests",
    "storybook": "storybook dev -p 9009",
    "build:storybook": "storybook build -o storybook-static",
    "sync:schema:check": "bun scripts/sync-custom-node-schema.ts --check",
    "check:single-instance": "bun scripts/check-single-instance.ts"
  },
