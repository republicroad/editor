  },
  {
    "type": "namespace",
    "title": "notify",
    "name": "notify",
    "description": "",
    "tools": [
      {
        "name": "webhook",
        "title": "webhook",
        "type": "function",
        "description": "向 IM 机器人 webhook 发送文本通知, 返回 { ok, status, body }. channel 支持 feishu/dingtalk/wecom/slack;带 title 时按渠道转 markdown 形态. webhook 地址支持 `${secret:名称}` 引用(按租户解析, 群机器人地址含凭证, 推荐走密钥),timeout/retry 语义与 http_request 一致(仅网络异常/超时/5xx/429 重试, 指数退避). ok 仅表示 HTTP 2xx;部分平台(如钉钉)限流/错参仍回 200, 业务错误码在 body.errcode, 规则可按需检查. 失败返回结构化错误, 不抛出异常.",
        "parameters": {
          "type": "object",
          "properties": {
            "channel": {
              "title": "Channel",
              "description": "通知渠道(feishu/dingtalk/wecom/slack), 决定 payload 形状, 默认 feishu",
              "default": "feishu",
              "type": "string"
            },
            "webhook": {
              "title": "Webhook URL",
              "description": "机器人 webhook 地址, 支持 `${secret:名称}` 引用(推荐, 地址含凭证不应落图)",
              "type": "string"
            },
            "message": { "title": "Message", "description": "通知正文(纯文本/markdown, ≤16KB)", "type": "string" },
            "title": {
              "title": "Title",
              "description": "可选标题; 提供时 feishu 拼接首行, dingtalk/wecom/slack 转对应 markdown 形态",
              "default": null,
              "type": "string"
            },
            "timeout": {
              "title": "Timeout",
              "description": "单次请求超时毫秒数(100–60000), 默认 10000",
              "default": 10000,
              "type": "integer"
            },
            "retry": {
              "title": "Retry",
              "description": "失败重试次数(0–5), 仅网络异常/超时/5xx/429 触发, 指数退避, 默认 0",
              "default": 0,
              "type": "integer"
            }
          },
          "required": ["webhook", "message"]
        },
        "returns": {
          "type": "object",
          "properties": {
            "ok": { "description": "HTTP 2xx 即 true; 平台业务错误码见 body", "type": "boolean" },
            "status": { "type": "integer" },
            "body": { "description": "平台响应体(如钉钉 { errcode, errmsg })" },
            "error": { "description": "失败原因(ok=false 时存在)", "type": "string" }
          },
          "required": ["ok", "status", "body"]
        },
        "namespace": "notify",
        "kind": "notify",
        "semantics": "act"
      }
    ],
    "meta": { "origin": "reference", "version": "0.12.0" }
  },
  {
    "type": "namespace",
    "title": "rate-window",
    "name": "rate-window",
    "description": "",
    "tools": [
      {
        "name": "rate_1h",
        "title": "rate_1h",
        "type": "function",
        "description": "旧域重建·频次统计：记录实体事件并返回其 1 小时滑动窗口内的事件计数。",
        "parameters": {
          "type": "object",
          "properties": { "entity": { "title": "实体", "description": "计数实体（如 ip、phone）", "type": "string" } },
          "required": ["entity"]
        },
        "returns": {
          "type": "object",
          "properties": {
            "counter": { "title": "Counter", "default": 0, "type": "integer" },
            "v": { "title": "V", "default": "", "type": "string" },
            "idle": { "title": "Idle", "default": 0, "type": "integer" },
            "timestamp": { "title": "Timestamp", "default": "", "type": "string" }
          },
          "required": ["counter", "v", "idle", "timestamp"]
        },
        "namespace": "rate-window",
        "kind": "rate-window",
        "semantics": "observe"
      },
