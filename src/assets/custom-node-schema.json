[
  {
    "type": "namespace",
    "title": "contrib",
    "name": "contrib",
    "description": "",
    "tools": [
      {
        "name": "inout",
        "title": "inout",
        "type": "function",
        "description": "Docstring for inout\n自定义函数测试, 返回值返回入参, 用于调试.",
        "parameters": {
          "properties": {
            "b": { "description": "参数 b", "title": "B", "type": "integer" },
            "a": {
              "anyOf": [{ "type": "string" }, { "type": "integer" }],
              "description": "参数 a",
              "title": "A"
            },
            "c": { "description": "参数 c", "title": "C", "type": "null" }
          },
          "required": ["b", "a", "c"],
          "title": "inout",
          "type": "object"
        },
        "returns": { "type": "string", "title": "inout 函数返回", "properties": {} },
        "namespace": "contrib",
        "kind": "contrib"
      },
      {
        "name": "func_without_args",
        "title": "func_without_args",
        "type": "function",
        "description": "Docstring for func_without_args\n无参数函数, 用于自定义函数测试",
        "parameters": {
          "properties": {},
          "title": "func_without_args",
          "type": "object"
        },
        "returns": { "type": "string", "title": "func_without_args 函数返回", "properties": {} },
        "namespace": "contrib",
        "kind": "contrib"
      },
      {
        "name": "http_request",
        "title": "http_request",
        "type": "function",
        "description": "发起 HTTP 请求, 返回响应结果 { status, headers, body }. 支持 params 查询参数合并、timeout 单次超时(默认 10s, 上限 60s)、retry 重试(仅网络异常/超时/5xx/429, 指数退避)与 auth 认证({ type: \"basic\", username, password } 或 { type: \"bearer\", token }, headers 显式 Authorization 优先). 失败返回结构化错误 { status: 0, error }, 不抛出异常.",
        "parameters": {
          "properties": {
            "url": { "description": "请求地址", "title": "URL", "type": "string" },
            "method": {
              "default": "GET",
              "description": "HTTP 方法(GET/POST/PUT/PATCH/DELETE/HEAD/OPTIONS)，默认 GET",
              "title": "Method",
              "type": "string"
            },
            "headers": {
              "default": null,
              "description": "请求头键值对对象，默认无",
              "title": "Headers",
              "type": "object"
            },
            "body": {
              "default": null,
              "description": "请求体对象(自动 JSON 序列化并补充 content-type: application/json)，GET/HEAD 忽略，空对象视为无请求体",
              "title": "Body",
              "type": "object"
            },
            "params": {
              "default": null,
              "description": "查询参数键值对对象，合并到 URL 查询串(URL 已有同名参数时覆盖)，默认无",
              "title": "Params",
              "type": "object"
            },
            "timeout": {
              "default": 10000,
              "description": "单次请求超时毫秒数(100–60000)，默认 10000",
              "title": "Timeout",
              "type": "integer"
            },
            "retry": {
              "default": 0,
              "description": "失败重试次数(0–5)，仅网络异常/超时/5xx/429 触发，指数退避，默认 0",
              "title": "Retry",
              "type": "integer"
            },
            "auth": {
              "default": null,
              "description": "认证配置。Basic: { type: 'basic', username, password }；Bearer: { type: 'bearer', token }。headers 显式 Authorization 优先，默认无",
              "title": "Auth",
              "type": "object"
            }
          },
          "required": ["url"],
          "title": "http_request",
          "type": "object"
        },
        "returns": { "type": "object", "title": "http_request 函数返回", "properties": {} },
        "namespace": "contrib",
        "kind": "contrib"
      },
      {
        "name": "crypto",
        "title": "crypto",
        "type": "function",
        "description": "计算字符串摘要或 HMAC 签名，返回摘要字符串. algorithm 支持 md5/sha1/sha256/sha512(非法值回退 sha256)，secret 非空时启用 HMAC 模式，encoding 支持 hex/base64/base64url(非法值回退 hex)，upper 仅对 hex 生效(大写输出).",
        "parameters": {
          "properties": {
            "input": {
              "description": "待摘要内容",
              "title": "Input",
              "type": "string"
            },
            "algorithm": {
              "default": "sha256",
              "description": "摘要算法(md5/sha1/sha256/sha512)，默认 sha256，非法值回退 sha256",
              "title": "Algorithm",
              "type": "string"
            },
            "secret": {
              "default": "",
              "description": "HMAC 密钥，非空启用 HMAC 模式，留空则为普通摘要",
              "title": "Secret",
              "type": "string"
            },
            "encoding": {
              "default": "hex",
              "description": "输出编码(hex/base64/base64url)，默认 hex，非法值回退 hex",
              "title": "Encoding",
              "type": "string"
            },
            "upper": {
              "default": false,
              "description": "hex 输出转大写(仅 encoding=hex 时生效)，默认 false",
              "title": "Upper",
              "type": "boolean"
            }
          },
          "required": ["input"],
          "title": "crypto",
          "type": "object"
        },
        "returns": { "type": "string", "title": "crypto 函数返回", "properties": {} },
        "namespace": "contrib",
        "kind": "contrib"
      }
    ]
  }
]
