[
  {
    "type": "namespace",
    "title": "ab-bucket",
    "name": "ab-bucket",
    "description": "",
    "tools": [
      {
        "name": "bucket",
        "title": "bucket",
        "type": "function",
        "description": "将 key 稳定哈希到 [0, buckets) 的整数桶号（FNV-1a，同 key 恒同桶，无状态无出网）。用于 A/B 分桶、灰度放量、按标识抽查。buckets 支持 1–1000，非法值回退 2。",
        "parameters": {
          "type": "object",
          "properties": {
            "key": { "title": "Key", "description": "分桶键（如 userId / deviceId）", "type": "string" },
            "buckets": { "title": "Buckets", "description": "桶数(1–1000)，默认 2", "default": 2, "type": "integer" }
          },
          "required": ["key"]
        },
        "returns": { "title": "桶号", "description": "[0, buckets) 内的整数", "type": "integer" },
        "namespace": "ab-bucket",
        "kind": "ab-bucket",
        "semantics": "query"
      }
    ],
    "meta": { "origin": "reference", "version": "0.12.0" }
  },
  {
    "type": "namespace",
    "title": "crypto",
    "name": "crypto",
    "description": "",
    "tools": [
      {
        "name": "crypto",
        "title": "crypto",
        "type": "function",
        "description": "计算字符串摘要或 HMAC 签名，返回摘要字符串. algorithm 支持 md5/sha1/sha256/sha512(非法值回退 sha256)，secret 非空时启用 HMAC 模式，encoding 支持 hex/base64/base64url(非法值回退 hex)，upper 仅对 hex 生效(大写输出).",
        "parameters": {
          "type": "object",
          "properties": {
            "input": { "title": "Input", "description": "待摘要内容", "type": "string" },
            "algorithm": {
              "title": "Algorithm",
              "description": "摘要算法(md5/sha1/sha256/sha512)，默认 sha256，非法值回退 sha256",
              "default": "sha256",
              "type": "string"
            },
            "secret": {
              "title": "Secret",
              "description": "HMAC 密钥，非空启用 HMAC 模式，留空则为普通摘要",
              "default": "",
              "type": "string"
            },
            "encoding": {
              "title": "Encoding",
              "description": "输出编码(hex/base64/base64url)，默认 hex，非法值回退 hex",
              "default": "hex",
              "type": "string"
            },
            "upper": {
              "title": "Upper",
              "description": "hex 输出转大写(仅 encoding=hex 时生效)，默认 false",
              "default": false,
              "type": "boolean"
            }
          },
          "required": ["input"]
        },
        "returns": { "title": "crypto 函数返回", "type": "string" },
        "namespace": "crypto",
        "kind": "crypto",
        "semantics": "query"
      }
    ],
    "meta": { "origin": "reference", "version": "0.12.0" }
  },
  {
    "type": "namespace",
    "title": "custom-list-query",
    "name": "custom-list-query",
    "description": "",
    "tools": [
      {
        "name": "custom_list_query",
        "title": "custom_list_query",
