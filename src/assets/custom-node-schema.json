  {
    "type": "namespace",
    "title": "geo",
    "name": "geo",
    "description": "",
    "tools": [
      {
        "name": "distance",
        "title": "distance",
        "type": "function",
        "description": "计算两经纬度点的 Haversine 大圆距离（球面近似，误差约 0.5%，决策场景够用）。unit 支持 km/m；坐标需同 datum（GCJ-02/WGS-84 混用会差 100–700m）。非法坐标返回结构化错误。",
        "parameters": {
          "type": "object",
          "properties": {
            "lat1": { "title": "Lat1", "description": "起点纬度 [-90, 90]", "type": "number" },
            "lon1": { "title": "Lon1", "description": "起点经度 [-180, 180]", "type": "number" },
            "lat2": { "title": "Lat2", "description": "终点纬度", "type": "number" },
            "lon2": { "title": "Lon2", "description": "终点经度", "type": "number" },
            "unit": { "title": "Unit", "description": "距离单位 km/m，默认 km", "default": "km", "type": "string" }
          },
          "required": ["lat1", "lon1", "lat2", "lon2"]
        },
        "returns": {
          "type": "object",
          "properties": {
            "distance": { "title": "距离", "anyOf": [{ "type": "number" }, { "type": "null" }] },
            "unit": { "title": "Unit", "type": "string" },
            "error": { "title": "Error", "type": "string" }
          },
          "required": ["distance"]
        },
        "namespace": "geo",
        "kind": "geo",
        "semantics": "query"
      },
      {
        "name": "fence",
        "title": "fence",
        "type": "function",
        "description": "围栏判定：圆形（circle: {lat, lon, radius km}）或多边形（polygon: [[lat,lon],...]，射线法）。返回 { inside, distance }——distance 为点到圆心/多边形的最近大圆距离(km)。",
        "parameters": {
          "type": "object",
          "properties": {
            "point": {
              "title": "Point",
              "description": "{ lat, lon }",
              "type": "object",
              "properties": {
                "lat": { "description": "纬度", "type": "number" },
                "lon": { "description": "经度", "type": "number" }
              },
              "required": ["lat", "lon"]
            },
            "circle": {
              "title": "Circle",
              "description": "{ lat, lon, radius(km)",
              "type": "object",
              "properties": {
                "lat": { "description": "圆心纬度", "type": "number" },
                "lon": { "description": "圆心经度", "type": "number" },
                "radius": { "description": "半径(km)", "type": "number" }
              },
              "required": ["lat", "lon", "radius"]
            },
            "polygon": {
              "title": "Polygon",
              "description": "[[lat,lon],...] 顶点序列，自动闭合",
              "type": "array",
              "items": {
                "anyOf": [
                  { "type": "array", "items": { "type": "number" } },
                  {
                    "type": "object",
                    "properties": { "lat": { "type": "number" }, "lon": { "type": "number" } },
                    "required": ["lat", "lon"]
                  }
                ]
              }
            }
          },
          "required": ["point"]
        },
        "returns": {
          "type": "object",
          "properties": {
            "inside": { "anyOf": [{ "type": "boolean" }, { "type": "null" }] },
            "distance": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
            "error": { "type": "string" }
          },
          "required": ["inside", "distance"]
        },
        "namespace": "geo",
        "kind": "geo",
        "semantics": "query"
      }
    ],
    "meta": { "origin": "reference", "version": "0.12.0" }
  },
  {
    "type": "namespace",
    "title": "http",
    "name": "http",
    "description": "",
    "tools": [
      {
        "name": "http_request",
        "title": "http_request",
        "type": "function",
        "description": "发起 HTTP 请求, 返回响应结果 { status, headers, body }. 支持 params 查询参数合并、timeout 单次超时(默认 10s, 上限 60s)、retry 重试(仅网络异常/超时/5xx/429, 指数退避)与 auth 认证({ type: \"basic\", username, password } 或 { type: \"bearer\", token }, headers 显式 Authorization 优先). 失败返回结构化错误 { status: 0, error }, 不抛出异常.",
        "parameters": {
          "type": "object",
          "properties": {
            "url": { "title": "URL", "description": "请求地址", "type": "string" },
            "method": {
              "title": "Method",
              "description": "HTTP 方法(GET/POST/PUT/PATCH/DELETE/HEAD/OPTIONS)，默认 GET",
              "default": "GET",
              "type": "string"
            },
            "headers": {
              "title": "Headers",
              "description": "请求头键值对对象，默认无",
              "type": "object",
              "properties": {}
            },
            "body": {
              "title": "Body",
              "description": "请求体对象(自动 JSON 序列化并补充 content-type: application/json)，GET/HEAD 忽略",
              "type": "object",
              "properties": {}
            },
            "params": {
              "title": "Params",
              "description": "查询参数键值对对象，合并到 URL 查询串(URL 已有同名参数时覆盖)，默认无",
              "type": "object",
              "properties": {}
            },
            "timeout": {
              "title": "Timeout",
              "description": "单次请求超时毫秒数(100–60000)，默认 10000",
              "default": 10000,
              "type": "integer"
            },
            "retry": {
              "title": "Retry",
              "description": "失败重试次数(0–5)，仅网络异常/超时/5xx/429 触发，指数退避，默认 0",
              "default": 0,
              "type": "integer"
            },
            "auth": {
              "title": "Auth",
              "description": "Basic: { type: 'basic', username, password }；Bearer: { type: 'bearer', token }",
              "type": "object",
              "properties": {
                "type": { "description": "Basic: 'basic', Bearer: 'bearer'", "type": "string" },
                "username": { "description": "Basic 用户名", "type": "string" },
                "password": { "description": "Basic 密码", "type": "string" },
                "token": { "description": "Bearer token", "type": "string" }
              },
              "required": ["type"]
            },
            "maxBytes": {
              "title": "MaxBytes",
              "description": "响应体积上限(字节)，默认 1MB，硬上限 64MiB",
              "type": "integer"
            }
          },
          "required": ["url"]
        },
        "returns": { "type": "null", "title": "", "properties": {} },
        "namespace": "http",
        "kind": "http",
        "semantics": "query"
      }
    ],
    "meta": { "origin": "reference", "version": "0.12.0" }
  },
  {
    "type": "namespace",
    "title": "ip-location",
