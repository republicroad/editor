          },
          "required": ["list_name", "value"]
        },
        "returns": {
          "type": "object",
          "properties": { "result": { "title": "Result", "type": "boolean" } },
          "required": ["result"]
        },
        "namespace": "custom-list-query",
        "kind": "custom-list-query",
        "semantics": "query"
      }
    ],
    "meta": { "origin": "reference", "version": "0.12.0" }
  },
  {
    "type": "namespace",
    "title": "dt",
    "name": "dt",
    "description": "",
    "tools": [
      {
        "name": "convert",
        "title": "convert",
        "type": "function",
        "description": "将 ISO 8601 瞬时转换为目标 IANA 时区的挂钟表示（Intl，DST 正确）。非法时区返回结构化错误。",
        "parameters": {
          "type": "object",
          "properties": {
            "datetime": { "title": "Datetime", "description": "ISO 8601 瞬时（含偏移或 Z）", "type": "string" },
            "to": { "title": "To", "description": "IANA 时区（如 Asia/Shanghai）", "type": "string" }
          },
          "required": ["datetime", "to"]
        },
        "returns": { "type": "null", "title": "", "properties": {} },
        "namespace": "dt",
        "kind": "dt",
        "semantics": "query"
      },
      {
        "name": "business_day",
        "title": "business_day",
        "type": "function",
        "description": "营业日推算：op=is_business_day/add_business_days/business_days_between/next_business_day。calendar={holidays[],workdays[],weekend?[0,6]} 为数据参数（判定优先级 假日>补班>周末）；不传 calendar = 纯周末模式（中国调休场景必须传）。区间上限 3 年。",
        "parameters": {
          "type": "object",
          "properties": {
            "date": { "title": "Date", "description": "YYYY-MM-DD", "type": "string" },
            "op": {
              "title": "Op",
              "description": "is_business_day / add_business_days / business_days_between / next_business_day",
              "type": "string"
            },
            "days": { "title": "Days", "description": "add/between 的天数", "type": "integer" },
            "to": { "title": "To", "description": "between 的结束日期 YYYY-MM-DD", "type": "string" },
            "calendar": {
              "title": "Calendar",
              "description": "{ holidays[], workdays[], weekend?[0,6] }——节假日表是数据，随国务院安排每年更新",
              "type": "object",
              "properties": {
                "holidays": { "description": "节假日", "type": "array", "items": { "type": "string" } },
                "workdays": { "description": "补班日", "type": "array", "items": { "type": "string" } },
                "weekend": {
                  "description": "周末（UTC day 编号，默认 [0,6]）",
                  "type": "array",
                  "items": { "type": "number" }
                }
              }
            }
          },
          "required": ["date", "op"]
        },
        "returns": { "type": "null", "title": "", "properties": {} },
        "namespace": "dt",
        "kind": "dt",
        "semantics": "query"
      },
      {
        "name": "diff",
        "title": "diff",
        "type": "function",
        "description": "日期差：unit=days（日历日）/ business_days（需 calendar）/ months（月末日钳制）。inclusive 缺省 false。",
        "parameters": {
          "type": "object",
          "properties": {
            "from": { "title": "From", "description": "YYYY-MM-DD", "type": "string" },
            "to": { "title": "To", "description": "YYYY-MM-DD", "type": "string" },
            "unit": {
              "title": "Unit",
              "description": "days / business_days / months",
              "default": "days",
              "type": "string"
            },
            "calendar": {
              "title": "Calendar",
              "description": "{ holidays[], workdays[], weekend?[0,6] }——节假日表是数据，随国务院安排每年更新",
              "type": "object",
              "properties": {
                "holidays": { "description": "节假日", "type": "array", "items": { "type": "string" } },
                "workdays": { "description": "补班日", "type": "array", "items": { "type": "string" } },
                "weekend": {
                  "description": "周末（UTC day 编号，默认 [0,6]）",
                  "type": "array",
                  "items": { "type": "number" }
                }
              }
            },
            "inclusive": { "title": "Inclusive", "default": false, "type": "boolean" }
          },
          "required": ["from", "to"]
        },
        "returns": { "type": "null", "title": "", "properties": {} },
        "namespace": "dt",
        "kind": "dt",
        "semantics": "query"
      }
    ],
    "meta": { "origin": "reference", "version": "0.12.0" }
  },
