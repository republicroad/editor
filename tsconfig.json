{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "noImplicitAny": true,
    "paths": {
      "@/*": ["./src/*"],
      "@republicroad/jdm-editor": ["./jdm-editor/packages/jdm-editor/src/index.ts"],
      "@republicroad/jdm-appshell": ["./jdm-editor/packages/appshell/src/index.ts"],
      "@republicroad/jdm-appshell/*": ["./jdm-editor/packages/appshell/*"],
    },
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    /* Linting */
    "strict": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src",
    "component-tests",
    "jdm-editor/packages/appshell/src",
    "jdm-editor/packages/jdm-editor/src/**/*.d.ts"
  ],
  "exclude": ["jdm-editor/packages/appshell/src/integration", "jdm-editor/packages/appshell/src/**/*.stories.tsx"],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
